# clangd configuration for the arduino_esp32 micro-ROS firmware.
#
# `compile_commands.json` is regenerated in this directory on every
# `colcon build --packages-select arduino_esp32` (see CMakeLists.txt's
# `compiledb` target). clangd discovers it via its default upward search.
#
# PlatformIO's compile_commands.json records the project's explicit -I
# flags, but NOT the cross compiler's *implicit* system include paths
# (libstdc++, libc, GCC builtins, sys-include). Without those, clangd
# parses the firmware against clang's host stdlib and reports nonsense
# like "'machine/endian.h' file not found" and "no known conversion
# from HardwareSerial to Stream &" (because Arduino's Stream.h is
# shadowed by the host's). We add the Xtensa GCC 8.4.0 system include
# paths explicitly here so clangd needs no editor-side --query-driver
# flag to make the firmware parse cleanly.
#
# CAVEAT: .clangd does not expand ~ / $HOME / env vars, so the paths
# below are absolute. The toolchain version "8.4.0" is pinned by the
# espressif32 PlatformIO platform we use; if you bump that platform,
# update the version fragments below to match the new
# ~/.platformio/packages/toolchain-xtensa-esp32/lib/gcc/xtensa-esp32-elf/<ver>
# directory.

CompileFlags:
  Add:
    # C++ standard library (libstdc++ shipped with the Xtensa GCC).
    - -isystem
    - /home/markop1/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/include/c++/8.4.0
    - -isystem
    - /home/markop1/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/include/c++/8.4.0/xtensa-esp32-elf
    - -isystem
    - /home/markop1/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/include/c++/8.4.0/backward
    # GCC builtin headers (stdint.h, stddef.h, stdarg.h, ...).
    - -isystem
    - /home/markop1/.platformio/packages/toolchain-xtensa-esp32/lib/gcc/xtensa-esp32-elf/8.4.0/include
    - -isystem
    - /home/markop1/.platformio/packages/toolchain-xtensa-esp32/lib/gcc/xtensa-esp32-elf/8.4.0/include-fixed
    # Newlib libc + Xtensa-specific (machine/endian.h, sys/*).
    - -isystem
    - /home/markop1/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/include
    - -isystem
    - /home/markop1/.platformio/packages/toolchain-xtensa-esp32/xtensa-esp32-elf/sys-include
  # Strip GCC-only / Xtensa-only flags PlatformIO emits that clang
  # doesn't understand and would otherwise turn into per-file warnings.
  Remove:
    - -mfix-esp32-psram-cache-issue
    - -mfix-esp32-psram-cache-strategy=memw
    - -mlongcalls
    - -mtext-section-literals
    - -fstrict-volatile-bitfields
    - -free
    - -fipa-pta
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap

Diagnostics:
  # Hide complaints about any remaining cross-toolchain flags clang
  # doesn't recognise.
  Suppress:
    - drv_unknown_argument
    - drv_unknown_argument_with_suggestion

---
# Don't lint third-party micro-ROS / Arduino / library sources under
# .pio/. Their warnings are noise for this project.
If:
  PathMatch: .*/\.pio/.*
Diagnostics:
  Suppress: '*'
